NODE_ENV=development

APP_NAME=Hono App
APP_PORT=3000
APP_URL=http://localhost:3000
APP_TIMEZONE=UTC
APP_KEY=your-app-key
LOG_LEVEL=info

# REQUIRED, no default. Signs access tokens. The process refuses to boot
# without it. Generate one: openssl rand -base64 48
JWT_SECRET=change-me-before-running

# REQUIRED, no default. Signs refresh tokens (POST /auth/refresh). Must differ
# from JWT_SECRET. Generate one: openssl rand -base64 48
JWT_REFRESH_SECRET=change-me-too-before-running

# API docs (Scalar UI at /docs, spec at /docs/openapi.json). The only switch,
# independent of NODE_ENV. Defaults to false when unset, so an environment that
# forgets it stays closed. On for local development; leave it off everywhere else.
ENABLE_API_DOCS=true

# Cluster mode: the primary spawns APP_CLUSTER_WORKERS Bun processes that share
# APP_PORT through SO_REUSEPORT. APP_CLUSTER_WORKERS=0 means one per CPU core.
APP_CLUSTER_MODE=false
APP_CLUSTER_WORKERS=0

# Reuse-port without cluster mode: run N processes yourself on the same port and
# let the kernel load-balance. Cluster mode already enables it for its workers.
APP_REUSE_PORT=false

CLIENT_URL=http://localhost:3000

# With docker compose, use service hostnames instead of localhost:
#   postgres / redis / clickhouse (e.g. @postgres:5432, REDIS_HOST=redis)
# Keep values UNQUOTED: `docker run --env-file` passes quotes literally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hono_clean

# Used by docker-compose.yml to provision the postgres container.
# Keep these in sync with DATABASE_URL.
POSTGRES_DB=hono_clean
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password123
REDIS_DB=0

# envalid treats `VAR=` as a provided empty string, not as absent, so an empty
# value here defeats the default declared in env.ts and fails validation at
# boot. Every MAIL_* line carries a real placeholder for that reason.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@example.com
MAIL_PASS=your_email_password
MAIL_FROM=noreply@example.com

# Comma-separated CORS origins. Empty or unset allows every origin (*).
ALLOWED_HOST=http://localhost:3000

# Optional ClickHouse (analytics). Not probed by /health.
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=secret
CLICKHOUSE_DATABASE=app
