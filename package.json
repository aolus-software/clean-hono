{
	"name": "clean-hono",
	"author": {
		"name": "Aolus Software"
	},
	"version": "0.1.0",
	"description": "A clean architecture template using Hono framework with Bun runtime.",
	"license": "MIT",
	"private": true,
	"scripts": {
		"dev": "bun run --hot --watch ./src/index.ts",
		"build": "bun run typecheck && bun build ./src/index.ts --outdir=dist --target=bun --minify && rm -rf dist/templates && cp -R src/libs/mail/templates dist/templates",
		"build:binary": "bun run typecheck && bun build ./src/index.ts --compile --outfile=server",
		"start": "bun run dist/index.js",
		"start:cluster": "APP_CLUSTER_MODE=true bun run dist/index.js",
		"lint": "bun run eslint . --ext .ts,.js",
		"lint:fix": "bun run eslint . --ext .ts,.js --fix",
		"format": "bun run prettier --write .",
		"format:check": "bun run prettier --check .",
		"prepare": "husky",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit introspect",
		"db:studio": "drizzle-kit studio",
		"db:drop": "bun run src/libs/database/postgres/scripts/drop.ts",
		"db:seed": "bun run src/libs/database/seed/index.ts",
		"db:clickhouse:migrate": "bun run src/libs/database/clickhouse/scripts/migrate.ts migrate",
		"db:clickhouse:status": "bun run src/libs/database/clickhouse/scripts/migrate.ts status",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:unit": "bun test tests/unit",
		"test:integration": "bun test tests/integration",
		"test:coverage": "bun test --coverage && bun run tests/coverage-gate.ts",
		"i18n:keys": "bun run src/libs/i18n/scripts/generate-keys.ts"
	},
	"dependencies": {
		"@clickhouse/client": "^1.24.1",
		"@hono/zod-openapi": "^1.6.3",
		"@scalar/hono-api-reference": "^0.12.17",
		"bcryptjs": "^3.0.3",
		"bullmq": "^6.5.3",
		"crypto-js": "^4.2.0",
		"dayjs": "^1.11.23",
		"dotenv": "^18.0.9",
		"drizzle-orm": "^0.45.4",
		"envalid": "^9.0.0",
		"hono": "^4.13.14",
		"hono-pino": "^0.10.3",
		"hono-rate-limiter": "^0.5.4",
		"ioredis": "^6.0.0",
		"nodemailer": "^10.3.1",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bcryptjs": "^3.0.0",
		"@types/bun": "^1.4.4",
		"@types/crypto-js": "^4.2.2",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.10",
		"typescript-eslint": "^8.72.1"
	}
}
